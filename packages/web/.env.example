# Supabase — copie do painel: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publicavel-ou-anon
SUPABASE_SERVICE_ROLE_KEY=

# URL canônica usada em SEO e callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_LEAD_FORM_URL=

# Segurança do Playground
# Produção não sobe tokens da API sem este segredo.
QALAB_TOKEN_SECRET=troque-por-um-segredo-longo-em-producao
QALAB_API_RATE_LIMIT_PER_MINUTE=120

# Google OAuth / Supabase Auth
# Google Cloud Authorized redirect URI:
# https://SEU_PROJECT_ID.supabase.co/auth/v1/callback
# Supabase Auth Redirect URLs:
# http://localhost:3002/auth/callback
# https://SEU_DOMINIO.com/auth/callback

# Painel de métricas do produto (/lab/metricas): e-mails autorizados, separados
# por vírgula. Vazio desliga o painel para todo mundo.
QALAB_ADMIN_EMAILS=

# Mercado Pago — Checkout Pro. Nunca exponha o access token nem o segredo do
# webhook no browser; ambos ficam somente no ambiente do servidor.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# ID numérico da conta recebedora esperado pelo checkout da mentoria.
MERCADO_PAGO_COLLECTOR_ID=

# Fase 6 - notificacoes transacionais da mentoria (Resend + Vercel Cron).
# Mantenha desligado em dev/staging ate validar o remetente e os destinatarios.
MENTORSHIP_EMAIL_ENABLED=false
MENTORSHIP_FROM_EMAIL=
RESEND_API_KEY=
CRON_SECRET=

# E2E mutante de Mentoria: use somente staging e dados descartaveis.
MENTORSHIP_E2E_MUTATIONS_ENABLED=false
MENTORSHIP_E2E_STUDENT_ID=
MENTORSHIP_E2E_COHORT_ID=
MENTORSHIP_E2E_WEEK=1
MENTORSHIP_E2E_STUDENT_USERNAME=
MENTORSHIP_E2E_PORTFOLIO_EMAIL=
MENTORSHIP_E2E_PORTFOLIO_PASSWORD=

# Jornada de admissão em staging: use aluno novo e turma aberta descartável.
MENTORSHIP_ADMISSION_E2E_ENABLED=false
MENTORSHIP_ADMISSION_E2E_STUDENT_EMAIL=
MENTORSHIP_ADMISSION_E2E_STUDENT_PASSWORD=
MENTORSHIP_ADMISSION_E2E_COHORT_ID=

# Checkout Pro cria uma preferencia pendente; habilite apenas com MP sandbox.
QA_E2E_CHECKOUT_ENABLED=false
QA_E2E_CHECKOUT_EMAIL=
QA_E2E_CHECKOUT_PASSWORD=
